AddFeature(GB.Gen, "AutoGeneratorPuzzle", {
    DisplayTitle = "Auto Generator", DisplayDescription = "Automatically completes generator puzzles when nearby",
    InstanceType = "BoolValue", DefaultInstanceValue = false, Savable = true,
    RNG = Random.new(),
    IsPlayersNear = function(self, d)
        if LocalCharacter and LocalRoot then
            for _, v in Players:GetPlayers() do
                if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    and (v.Character.HumanoidRootPart.Position - LocalRoot.Position).Magnitude < d then
