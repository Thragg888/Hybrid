        if not GetValue("AutoGeneratorPuzzle") or IsFixingGenerator or not LocalRoot or not GameMap then return end
        for _, Gen in GameMap:QueryDescendants("Model#Generator:has(#Main)") do
            local main = Gen:FindFirstChild("Main")
            if main and (main.Position - LocalRoot.Position).Magnitude < 7 then
                local remotes = Gen:FindFirstChild("Remotes")
                local progress = Gen:FindFirstChild("Progress")
                local re = remotes and remotes:FindFirstChildOfClass("RemoteEvent")
                if re and PlayerGui:FindFirstChild("PuzzleUI") and progress and progress.Value < 100 then
                    IsFixingGenerator = true
                    task.spawn(function()
                        while GetValue("AutoGeneratorPuzzle") and progress.Value < 100 and PlayerGui:FindFirstChild("PuzzleUI") do
                            local near = self:IsPlayersNear(32)
                            local baseCD = GetValue("GeneratorCooldown") or 4
                            local cd = (not near and GetValue("SpeedUpCooldown")) and math.max(baseCD * 0.4, 1.5) or baseCD
                            task.wait(self.RNG:NextNumber(cd * 0.9, cd * 1.1))
                            if not GetValue("AutoGeneratorPuzzle") then break end
                            pcall(function() re:FireServer() end)
                            PlaySound("puzzleDone", {["Parent"] = main})
                        end
                        IsFixingGenerator = false
                    end)
                end
                break
            end
        end
    end,
