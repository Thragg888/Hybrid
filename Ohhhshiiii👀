-- ============================================================
-- Core element-builder (with proper two-way binding + guards)
-- ============================================================
local function AddFeature(groupbox, name, data)
    -- 1. create backing instance (the real source of truth)
    local inst = Instance.new(data.InstanceType)
    inst.Name = name
    inst.Value = data.DefaultInstanceValue
    inst:SetAttribute("DisplayTitle", (data.DisplayTitle or name):gsub("<.->", ""))
    inst:SetAttribute("DisplayDescription", (data.DisplayDescription or ""):gsub("<.->", ""))
    if data.ExtraData then
        for k, v in data.ExtraData do inst:SetAttribute(k, v) end
    end
    inst.Parent = PlusFolderSettings
    data.Instance = inst
    Values[name] = inst

    -- 2. fire initial ScriptFunction (Starting = true)
    if data.ScriptFunction then
        task.spawn(function() pcall(data.ScriptFunction, data, inst.Value, true) end)
    end

    -- 3. element callback + instance-change guard
    local updating = false
    local function fireSF(v)
        if data.ScriptFunction then pcall(data.ScriptFunction, data, v, false) end
    end

    local cb = function(v)
        if updating then return end
        if inst.Value == v then return end
        updating = true
        inst.Value = v
        fireSF(v)
        updating = false
    end

    local element
    if data.InstanceType == "BoolValue" then
        element = groupbox:AddToggle(name, {
            Text     = inst:GetAttribute("DisplayTitle"),
            Tooltip  = inst:GetAttribute("DisplayDescription"),
            Default  = inst.Value,
            Callback = cb,
        })
    elseif data.InstanceType == "NumberValue" then
        element = groupbox:AddSlider(name, {
            Text     = inst:GetAttribute("DisplayTitle"),
            Tooltip  = inst:GetAttribute("DisplayDescription"),
            Default  = inst.Value,
            Min      = inst:GetAttribute("MinValue") or 0,
            Max      = inst:GetAttribute("MaxValue") or 100,
            Rounding = (inst:GetAttribute("Step") or 1) < 1 and 1 or 0,
            Callback = cb,
        })
    elseif data.InstanceType == "StringValue" then
        local optsStr = inst:GetAttribute("Options") or ""
        local opts = {}
        for part in optsStr:gmatch("[^|]+") do table.insert(opts, part) end
        if #opts == 0 then opts = {inst.Value} end
        element = groupbox:AddDropdown(name, {
            Text     = inst:GetAttribute("DisplayTitle"),
            Tooltip  = inst:GetAttribute("DisplayDescription"),
            Values   = opts,
            Default  = inst.Value,
            Multi    = false,
            Searchable = #opts > 10,
            Callback = cb,
        })
    end

    -- instance → UI sync (catches programmatic changes e.g. Invincible → DisableToxicTrails)
    Track(inst:GetPropertyChangedSignal("Value"):Connect(function()
        if updating then return end
        if not element or element.Value == inst.Value then return end
        updating = true
        if element.SetValue then pcall(element.SetValue, element, inst.Value) end
        fireSF(inst.Value)
        updating = false
    end))

    -- 4. lifecycle
    if data.CustomSetup then task.spawn(function() pcall(data.CustomSetup, data) end) end
    if data.OnLoop then
        Track(RunService.Heartbeat:Connect(function()
            if data.OnLoop then pcall(data.OnLoop, data) end
        end))
    end
    if data.CharacterAdded then
        Track(LocalPlayer.CharacterAdded:Connect(function()
            task.delay(0, function() pcall(data.CharacterAdded, data) end)
        end))
    end

    return element, inst
end

