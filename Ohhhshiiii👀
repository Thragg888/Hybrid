AddFeature(GB.ESP, "ESP", {
    DisplayTitle = "ESP Master", DisplayDescription = "Wallhack for players, generators, and items",
    InstanceType = "BoolValue", DefaultInstanceValue = false, Savable = true,
    ScriptFunction = function(self, v)
        if not v then
            for _, root in {PlayersFolder, GameMap, InGame, workspace} do
                if root then
                    for _, d in root:GetDescendants() do
                        local h = d:FindFirstChild("_SS_ESP");   if h then h:Destroy() end
                        local t = d:FindFirstChild("_SS_ESPText"); if t then t:Destroy() end
                    end
                end
            end
        end
    end,
    OnLoop = function()
        if not GetValue("ESP") then return end
        local cam = workspace.CurrentCamera
        if not cam then return end
        -- players
        if PlayersFolder then
            for _, pm in PlayersFolder:QueryDescendants("#Killers > Instance, #Survivors > Instance") do
                local plr = Players:GetPlayerFromCharacter(pm)
                local hum = pm:FindFirstChildOfClass("Humanoid")
                local root = pm:FindFirstChild("HumanoidRootPart")
                local folder = pm.Parent and pm.Parent.Name or ""
                local en = GetValue(folder .. "ESP")
                if plr and hum and hum.Health > 0 and root and en then
                    local color = ColorPresets[GetValue(folder .. "Color")] or Color3.new(1,1,1)
                    local hl = pm:FindFirstChild("_SS_ESP")
                    if not hl then
                        hl = Instance.new("Highlight"); hl.Name = "_SS_ESP"
                        hl.FillTransparency = 0.55; hl.OutlineTransparency = 0
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = pm; hl.Parent = pm
                    end
                    hl.FillColor = color; hl.OutlineColor = color
                    if GetValue("ShowText") then
                        local bg = pm:FindFirstChild("_SS_ESPText")
                        if not bg then
                            bg = Instance.new("BillboardGui")
                            bg.Name = "_SS_ESPText"; bg.Adornee = root
                            bg.Size = UDim2.fromOffset(180, 44)
                            bg.StudsOffset = Vector3.new(0, 3.2, 0)
                            bg.AlwaysOnTop = true; bg.Parent = pm
                            local t = Instance.new("TextLabel")
                            t.Parent = bg; t.Size = UDim2.fromScale(1, 1)
                            t.BackgroundTransparency = 1; t.TextScaled = true
                            t.TextStrokeTransparency = 0.4
                            t.Font = Enum.Font.GothamBold
                        end
                        bg.Adornee = root
                        local t = bg:FindFirstChildWhichIsA("TextLabel")
                        if t then t.Text = plr.Name; t.TextColor3 = color end
                    else
                        local bg = pm:FindFirstChild("_SS_ESPText"); if bg then bg:Destroy() end
                    end
                else
                    local hl = pm:FindFirstChild("_SS_ESP"); if hl then hl:Destroy() end
                    local bg = pm:FindFirstChild("_SS_ESPText"); if bg then bg:Destroy() end
                end
            end
        end
        -- generators
        if GameMap and GetValue("GeneratorsESP") then
            local color = ColorPresets[GetValue("GeneratorsColor")] or Color3.new(0,1,1)
            for _, gen in GameMap:QueryDescendants("Model#Generator:has(#Main)") do
                local prog = gen:FindFirstChild("Progress")
                local done = GetValue("GeneratorsCheck") and prog and prog.Value >= 100
                if done then
                    local h = gen:FindFirstChild("_SS_ESP"); if h then h:Destroy() end
                else
                    local hl = gen:FindFirstChild("_SS_ESP")
                    if not hl then
                        hl = Instance.new("Highlight"); hl.Name = "_SS_ESP"
                        hl.FillTransparency = 0.55
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Adornee = gen; hl.Parent = gen
                    end
                    hl.FillColor = color; hl.OutlineColor = color
                end
            end
        end
    end,
})
