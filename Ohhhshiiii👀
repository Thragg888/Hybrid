-- Tab creation — ALL tabs created BEFORE any element
-- ============================================================
local Tabs, Sections = {}, {}
local ORDER = {"Automation", "Features", "Visuals", "Miscellaneous"}

for _, tabName in ORDER do
    local tabData = FeatureLoadout[tabName]
    if tabData and tabData.TabAttributes then
        Tabs[tabName] = Window:Tab({
            Title = tabData.TabAttributes.DisplayTitle,
            Icon = "circle",
            Locked = false,
        })
        task.wait(0.05)
        Sections[tabName] = Tabs[tabName]:Section({
            Title = tabData.TabAttributes.DisplayTitle .. " Options",
            TextXAlignment = "Left",
        })
    end
end

-- ============================================================
-- Element creation — synchronous, pcall-protected, ordered
-- ============================================================
local function BuildElement(tabName, featureName, data)
    local section = Sections[tabName]
    if not section then return end

    -- backing instance
    local inst = Instance.new(data.InstanceType)
    inst.Name = featureName
    inst.Value = data.DefaultInstanceValue
    inst:SetAttribute("DisplayTitle", (data.DisplayTitle or "Untitled"):gsub("<.->", ""))
    inst:SetAttribute("DisplayDescription", (data.DisplayDescription or ""):gsub("<.->", ""))
    if data.ExtraData then
        for k, v in data.ExtraData do inst:SetAttribute(k, v) end
    end
    inst.Parent = PlusFolderSettings
    data.Instance = inst
    Values[featureName] = inst

    -- persistence
    if data.Savable and isfile and isfile(FilePath("Data.txt")) then
        local ok, saved = pcall(function() return HttpService:JSONDecode(ReturnData("Data.txt") or "{}") end)
        if ok and saved and saved[featureName] ~= nil then inst.Value = saved[featureName] end
        inst:GetPropertyChangedSignal("Value"):Connect(function()
            local ok2, t = pcall(function() return HttpService:JSONDecode(ReturnData("Data.txt") or "{}") end)
            if not ok2 or type(t) ~= "table" then return end
            t[featureName] = inst.Value
            ChangeData("Data.txt", HttpService:JSONEncode(t))
        end)
    end

    -- build the WindUI element
    local cb = function(v)
        inst.Value = v
        if data.ScriptFunction then
            local ok, err = pcall(data.ScriptFunction, data, v, false)
            if not ok then warn(("[Slashsaken] %s.ScriptFunction error: %s"):format(featureName, err)) end
        end
    end

    if data.InstanceType == "BoolValue" then
        section:Toggle({ Title = inst:GetAttribute("DisplayTitle"), Desc = inst:GetAttribute("DisplayDescription"), Value = inst.Value, Callback = cb })
    elseif data.InstanceType == "NumberValue" then
        section:Slider({
            Title = inst:GetAttribute("DisplayTitle"), Desc = inst:GetAttribute("DisplayDescription"),
            Value = inst.Value,
            Min = inst:GetAttribute("MinValue") or 0, Max = inst:GetAttribute("MaxValue") or 100,
            Step = inst:GetAttribute("Step") or 1,
            Callback = cb,
        })
    elseif data.InstanceType == "StringValue" then
        local optsStr = inst:GetAttribute("Options") or ""
        local opts = {}
        for part in optsStr:gmatch("[^|]+") do table.insert(opts, part) end
        if #opts == 0 then opts = {inst.Value} end
        section:Dropdown({
            Title = inst:GetAttribute("DisplayTitle"), Desc = inst:GetAttribute("DisplayDescription"),
            Values = opts, Value = inst.Value, Multi = false,
            Callback = function(v)
                -- WindUI dropdowns sometimes pass a table
                if type(v) == "table" then v = v[1] end
                cb(v)
            end,
        })
    end

    -- lifecycle
    if data.CustomSetup then
        task.spawn(function()
            local ok, err = pcall(data.CustomSetup, data)
            if not ok then warn(("[Slashsaken] %s.CustomSetup error: %s"):format(featureName, err)) end
        end)
    end
    if data.OnLoop then
        RunService.Heartbeat:Connect(function()
            if data.OnLoop then
                local ok, err = pcall(data.OnLoop, data)
                if not ok then warn(("[Slashsaken] %s.OnLoop error: %s"):format(featureName, err)) end
            end
        end)
    end
    if data.CharacterAdded then
        LocalPlayer.CharacterAdded:Connect(function()
            task.delay(0, function()
                local ok, err = pcall(data.CharacterAdded, data)
                if not ok then warn(("[Slashsaken] %s.CharacterAdded error: %s"):format(featureName, err)) end
            end)
        end)
    end
end

-- iterate in deterministic order per tab
local function SortedKeys(tabData)
    local keys = {}
    for k, v in tabData do
        if k ~= "TabAttributes" and type(v) == "table" and v.InstanceType then
            table.insert(keys, {Name = k, Order = v.LayoutOrder or 999, Data = v})
        end
    end
    table.sort(keys, function(a, b) return a.Order < b.Order end)
    return keys
end

for _, tabName in ORDER do
    local tabData = FeatureLoadout[tabName]
    if tabData then
        for _, entry in SortedKeys(tabData) do
            local ok, err = pcall(BuildElement, tabName, entry.Name, entry.Data)
            if not ok then
                warn(("[Slashsaken] Failed to build %s.%s: %s"):format(tabName, entry.Name, err))
            end
        end
    end
end

