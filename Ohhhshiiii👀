local function OnCharacter(char)
    LocalCharacter = char
    LocalHumanoid = char and (char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 2)) or nil
    LocalHead = char and (char:FindFirstChild("Head") or char:WaitForChild("Head", 2)) or nil
    LocalRoot = char and ((LocalHumanoid and LocalHumanoid.RootPart) or char:FindFirstChild("HumanoidRootPart")) or nil
    LocalAnimator = LocalHumanoid and (LocalHumanoid:FindFirstChildOfClass("Animator") or LocalHumanoid:WaitForChild("Animator", 2)) or nil
    SpeedMultipliers = char and (char:FindFirstChild("SpeedMultipliers") or char:WaitForChild("SpeedMultipliers", 5)) or nil
    ResistanceMultipliers = char and (char:FindFirstChild("ResistanceMultipliers") or char:WaitForChild("ResistanceMultipliers", 5)) or nil
    FOVMultipliers = char and (char:FindFirstChild("FOVMultipliers") or char:WaitForChild("FOVMultipliers", 5)) or nil
end
