-- ============================================================
-- Wire each FeatureLoadout entry into a WindUI element
-- ============================================================
local function BuildWindElement(tabName, featureName, data)
    local tab, defaultSection = EnsureTab(tabName, FeatureLoadout[tabName].TabAttributes.DisplayTitle, FeatureLoadout[tabName].TabAttributes.LayoutOrder)

    -- create the backing instance (still required for GetValue + game logic)
    local Inst = Instance.new(data.InstanceType)
    Inst.Name = featureName
    Inst.Value = data.DefaultInstanceValue
    Inst:SetAttribute("DisplayTitle", data.DisplayTitle or "Untitled Feature")
    Inst:SetAttribute("DisplayDescription", (data.DisplayDescription or ""):gsub("<.->", ""))
    Inst:SetAttribute("LayoutOrder", data.LayoutOrder or 1)
    if data.ExtraData then
        for k, v in data.ExtraData do Inst:SetAttribute(k, v) end
    end
    Inst.Parent = PlusFolderSettings

    data.Instance = Inst
    Values[featureName] = Inst

    -- persistence
    if data.Savable and FeatureLoadout["EnviromentFunctions"]["files"]["DefaultInstanceValue"] then
        local TableData = HttpService:JSONDecode(ReturnData("Data.txt") or "{}")
        if TableData[featureName] ~= nil then Inst.Value = TableData[featureName] end
        Inst:GetPropertyChangedSignal("Value"):Connect(function()
            local t = HttpService:JSONDecode(ReturnData("Data.txt") or "{}")
            t[featureName] = data.DefaultInstanceValue == Inst.Value and nil or Inst.Value
            ChangeData("Data.txt", HttpService:JSONEncode(t))
        end)
    end

    -- build WindUI element
    local El
    if data.InstanceType == "BoolValue" then
        El = defaultSection:Toggle({
            Title = Inst:GetAttribute("DisplayTitle"),
            Desc  = Inst:GetAttribute("DisplayDescription"),
            Value = Inst.Value,
            Callback = function(v)
                Inst.Value = v
                if data.ScriptFunction then data:ScriptFunction(v, false) end
            end,
        })
    elseif data.InstanceType == "NumberValue" then
        El = defaultSection:Slider({
            Title = Inst:GetAttribute("DisplayTitle"),
            Desc  = Inst:GetAttribute("DisplayDescription"),
            Value = Inst.Value,
            Min   = Inst:GetAttribute("MinValue") or 0,
            Max   = Inst:GetAttribute("MaxValue") or 100,
            Step  = Inst:GetAttribute("Step")     or 1,
            Callback = function(v)
                Inst.Value = v
                if data.ScriptFunction then data:ScriptFunction(v, false) end
            end,
        })
    elseif data.InstanceType == "StringValue" then
        local opts = (Inst:GetAttribute("Options") or ""):split("|")
        El = defaultSection:Dropdown({
            Title  = Inst:GetAttribute("DisplayTitle"),
            Desc   = Inst:GetAttribute("DisplayDescription"),
            Values = opts,
            Value  = Inst.Value,
            Multi  = false,
            Callback = function(v)
                Inst.Value = v
                if data.ScriptFunction then data:ScriptFunction(v, false) end
            end,
        })
    end

    data.WindElement = El

    -- feature lifecycle hooks
    if data.CustomSetup then task.spawn(data.CustomSetup, data) end
    if data.OnLoop then
        RunService.Heartbeat:Connect(function()
            if data.OnLoop and Inst.Value ~= false and Inst.Value ~= "Original" then
                pcall(data.OnLoop, data)
            end
        end)
    end
    if data.CharacterAdded then
        LocalPlayer.CharacterAdded:Connect(function()
            task.delay(0, function() task.spawn(data.CharacterAdded, data) end)
        end)
    end
end

-- iterate all tabs/sections
for tabName, tabData in FeatureLoadout do
    if tabName == "EnviromentFunctions" then continue end
    for featureName, featureData in tabData do
        if featureName == "TabAttributes" then continue end
        task.spawn(BuildWindElement, tabName, featureName, featureData)
        task.wait()
    end
end

