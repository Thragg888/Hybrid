-- ============================================================
function getNearestKillerModel()
    local myRoot = LocalCharacter and LocalCharacter:FindFirstChild("HumanoidRootPart")
    if not myRoot or not KillersFolder then return nil end
    local closest, closestDist = nil, math.huge
    for _, k in KillersFolder:GetChildren() do
        if k and k:IsA("Model") then
            local hrp = k:FindFirstChild("HumanoidRootPart")
            if hrp then
                local d = (hrp.Position - myRoot.Position).Magnitude
                if d < closestDist then closest, closestDist = k, d end
            end
        end
    end
    return closest
end

function getKillerHRP(killerModel)
    if not killerModel then return nil end
    return killerModel:FindFirstChild("HumanoidRootPart") or killerModel.PrimaryPart or killerModel:FindFirstChildWhichIsA("BasePart", true)
end

-- ============================================================
-- HDT — move toward killer at user speed + look at killer
-- ============================================================
function StartHDT(killer)
    if not HDT_Enabled or HDT_Debounce then return end
    if not killer or not killer.Parent then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local killerRoot = getKillerHRP(killer)
    if not killerRoot then return end

    HDT_Debounce = true

    local oldWS = hum.WalkSpeed
    local oldJP = hum.JumpPower
    local oldPS = hum.PlatformStand
    local oldAR = hum.AutoRotate

    hum.WalkSpeed = 0
    hum.JumpPower = 0
    hum.PlatformStand = false
    hum.AutoRotate = false

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e5, 0, 1e5)
    bv.Velocity = Vector3.new(0, 0, 0)
    bv.Parent = hrp

    if HDT_Delay > 0 then task.wait(HDT_Delay) end

    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not HDT_Debounce or not HDT_Enabled then
            conn:Disconnect()
            if bv and bv.Parent then pcall(function() bv:Destroy() end) end
            if char and char.Parent and hum and hum.Parent then
                hum.WalkSpeed = oldWS; hum.JumpPower = oldJP
                hum.PlatformStand = oldPS; hum.AutoRotate = oldAR
            end
            return
        end

        if not (char and char.Parent) or not (killer and killer.Parent) then
            HDT_Debounce = false; return
        end

        local currentRoot = getKillerHRP(killer)
        if not currentRoot then HDT_Debounce = false; return end

        local toTarget = currentRoot.Position - hrp.Position
        local horiz = Vector3.new(toTarget.X, 0, toTarget.Z)

        if horiz.Magnitude > 0.1 then
            local dir = horiz.Unit
            bv.Velocity = Vector3.new(dir.X * HDT_Speed, bv.Velocity.Y, dir.Z * HDT_Speed)
            local lookAt = Vector3.new(currentRoot.Position.X, hrp.Position.Y, currentRoot.Position.Z)
            pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, lookAt) end)
        end

        if toTarget.Magnitude <= 2.5 then HDT_Debounce = false end
    end)

    task.delay(1.5 + HDT_Delay, function() if HDT_Debounce then HDT_Debounce = false end end)
end

-- ============================================================
-- Aim Punch — lock char/camera onto killer when local punch anim plays
-- ============================================================
function DoAimLock()
    if not AimPunch_Enabled then return end
    if tick() - aimPunchLastTrigger < AimPunch_Cooldown then return end

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    local killer = getNearestKillerModel()
    if not killer then return end
    local killerRoot = killer:FindFirstChild("HumanoidRootPart")
    if not killerRoot then return end

    aimPunchLastTrigger = tick()

    local oldAR = hum.AutoRotate
    if AimPunch_CharLock then hum.AutoRotate = false end

    task.spawn(function()
        local start = tick()
        local cam = workspace.CurrentCamera
        while tick() - start < AimPunch_Duration do
            if not (hrp and hrp.Parent) or not (killerRoot and killerRoot.Parent) then break end
            local predicted = killerRoot.Position + killerRoot.CFrame.LookVector * AimPunch_Prediction
            if AimPunch_CharLock then
                pcall(function() hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(predicted.X, hrp.Position.Y, predicted.Z)) end)
            end
            if AimPunch_CamLock and cam then
                pcall(function() cam.CFrame = CFrame.lookAt(cam.CFrame.Position, predicted) end)
            end
            task.wait()
        end
        if hum and hum.Parent and AimPunch_CharLock then hum.AutoRotate = oldAR end
    end)
end

local function SetupLocalAimPunch(char)
    local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    local anim = hum and hum:FindFirstChildOfClass("Animator")
    if not anim then return end
    Track(anim.AnimationPlayed:Connect(function(track)
        if not AimPunch_Enabled then return end
        local animId = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
        if animId and table.find(LocalPunchAnimIds, animId) then DoAimLock() end
    end))
end

