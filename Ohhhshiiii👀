        ["AutoBlock"] = {
            ["DisplayDescription"] = "Predictive block — fires on attack animation start + PreSimulation hitbox sweep. Requires good ping.",
            ["DisplayTitle"] = "Guest1337 Auto Block",
            ["LayoutOrder"] = 14,
            ["Savable"] = true,
            ["InstanceType"] = "BoolValue",
            ["DefaultInstanceValue"] = false,
            ["HandleKiller"] = function(self, Killer)
                local BlockableAttacks = {"slash", "enragedslash", "stab", "attack", "punch", "swing", "golemslash"}
                local CustomHitboxes = {
                    ["golemslash"] = { Size = Vector3.new(6, 2, 7), Offset = CFrame.new(0, 0, -5.5) },
                }
                local FireSignal     = GetFunction(firesignal, FireSignal)
                local UseActorAbility = Network and Network:FindFirstChildOfClass("RemoteEvent")
                local ShowHitboxesSetting = PlayerData and PlayerData:FindFirstChild("Settings") and PlayerData.Settings:FindFirstChild("ShowHitboxes", true)
                local Humanoid     = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid")
                local QueryHitbox  = Killer:FindFirstChild("QueryHitbox")   or Killer:WaitForChild("QueryHitbox")
                local KillerAnimator = Humanoid:FindFirstChildOfClass("Animator")

                -- tunables
                local LeadTime        = 0.03   -- seconds to fire BEFORE hit registers
                local BlockCooldown   = 0.35   -- seconds between block calls
                local SweepWindow     = 0.55   -- how long after anim start to keep sweeping
                local SweepSizeMul    = 2.5    -- hitbox expansion multiplier

                local LastBlockAt = 0
                local function DoBlock()
                    if tick() - LastBlockAt < BlockCooldown then return end
                    LastBlockAt = tick()
                    -- fire on game UI button if available
                    if FireSignal and MainUI:FindFirstChild("AbilityContainer") and MainUI.AbilityContainer:FindFirstChild("Block") then
                        pcall(FireSignal, MainUI.AbilityContainer.Block.MouseButton1Click)
                    end
                    -- fire remote (both arg shapes for compat)
                    if UseActorAbility then
                        if GetValue("OfficialGame") then
                            pcall(function() UseActorAbility:FireServer("UseActorAbility", {"Block"}) end)
                        else
                            pcall(function() UseActorAbility:FireServer("UseActorAbility", "Block") end)
                            pcall(function() UseActorAbility:FireServer("UseActorAbility", {"Block"}) end)
                        end
                    end
                end

                local SelfParams = OverlapParams.new()
                SelfParams.MaxParts = 1
                SelfParams.FilterType = Enum.RaycastFilterType.Include

                if not KillerAnimator then return end

                KillerAnimator.AnimationPlayed:Connect(function(Track)
                    if not GetValue("AutoBlock") then return end
                    if not Players:GetPlayerFromCharacter(Killer) then return end
                    if not LocalCharacter or not LocalCharacter:FindFirstChild("QueryHitbox") then return end
                    if LocalCharacter.Parent ~= SurvivorsFolder then return end

                    local AnimType = GetAnimationType(Track.Animation.AnimationId)
                    if not AnimType or type(AnimType) ~= "string" then return end
                    if not table.find(BlockableAttacks, AnimType:lower()) then return end

                    -- fire block IMMEDIATELY on animation start (lead time)
                    task.delay(LeadTime, DoBlock)

                    local CustomHitbox = CustomHitboxes[AnimType:lower()] or CustomHitboxes[Killer.Name:lower()]
                    local StopAt = tick() + math.min(Track.Length > 0 and Track.Length or SweepWindow, SweepWindow)

                    -- PreSimulation hitbox sweep (much higher frequency than original task.wait loop)
                    local Conn
                    Conn = RunService.PreSimulation:Connect(function()
                        if tick() >= StopAt or not GetValue("AutoBlock") then
                            if Conn then Conn:Disconnect() end
                            return
                        end
                        if not LocalCharacter or not LocalCharacter:FindFirstChild("QueryHitbox") or not QueryHitbox or not QueryHitbox.Parent then
                            if Conn then Conn:Disconnect() end
                            return
                        end

                        SelfParams.FilterDescendantsInstances = {LocalCharacter:FindFirstChild("QueryHitbox")}
                        local Check = Instance.new("Part")
                        Check.Size = (CustomHitbox and CustomHitbox.Size or Vector3.new(5.2, 6, 5.65)) * SweepSizeMul
                        Check.CFrame = QueryHitbox.CFrame * (CustomHitbox and CustomHitbox.Offset or CFrame.new(0, 0, -3.5))
                        Check.CanCollide = false
                        Check.Anchored = true
                        Check.CastShadow = false
                        Check.Transparency = (ShowHitboxesSetting and ShowHitboxesSetting.Value) and 0.15 or 1
                        Check.Material = Enum.Material.ForceField
                        Check.Parent = Hitboxes or workspace
                        local Hit = #workspace:GetPartsInPart(Check, SelfParams) > 0
                        Check:Destroy()

                        if Hit then DoBlock() end
                    end)
                end)
            end,
