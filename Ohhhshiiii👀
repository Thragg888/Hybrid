function GetValue(name, instanceOnly)
    local inst = Values[name]
    if not inst then inst = PlusFolderSettings:FindFirstChild(name, true); Values[name] = inst end
    if instanceOnly then return inst end
    return inst and inst.Value
end

function TableValueFind(T, Match, Seen)
    if type(T) ~= "table" then return nil end
    Seen = Seen or {}; if Seen[T] then return nil end; Seen[T] = true
    for K, V in T do
        if Match(K, V) then return V, K, T
        elseif type(V) == "table" then
            local rv, rk, rp = TableValueFind(V, Match, Seen)
            if rk ~= nil then return rv, rk, rp end
        end
    end
    return nil
end

function PlaySound(SoundName, Settings)
    local snd = typeof(SoundName) == "string" and AssetsFolder and AssetsFolder.Sounds and AssetsFolder.Sounds:FindFirstChild(SoundName, true) or nil
    if snd then
        task.spawn(function()
            snd = snd:Clone()
            snd.Parent = workspace:FindFirstChild("Sounds") or workspace
            if type(Settings) == "table" then for k, v in Settings do snd[k] = v end end
            snd:Play(); Debris:AddItem(snd, snd.TimeLength + 1)
        end)
    end
end

-- ============================================================
-- Animation-name resolution (Forsaken Plus method)
-- Reads KillerAssets.<Name>.Config.Animations and maps
-- numeric ID -> semantic name ("Slash", "Stab", etc.)
-- ============================================================
function PopulateAnimations()
    if not IsRequireSupported then return end
    if not (KillerAssets and SurvivorAssets and SkinsAssets) then return end

    local configs = {}
    for _, v in KillerAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end
    for _, v in SurvivorAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end
    for _, v in SkinsAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end

    for _, cfg in configs do
        if not cfg.Parent or cfg.Parent:IsA("Model") then continue end
        local ok, data = pcall(require, cfg)
        if not ok or type(data) ~= "table" or not data.Animations then continue end
        local charName = cfg.Parent and cfg.Parent.Name or "?"
        if data.DisplayName and data.DisplayName:find("Milestone") then
            charName = string.format("%s %s", cfg.Parent and cfg.Parent.Parent and cfg.Parent.Parent.Name or charName, data.DisplayName:gsub("Milestone ", ""))
        end
        AllAnimations[charName] = data.Animations

        for animName, animId in data.Animations do
            if type(animId) == "table" then
                for _, subId in animId do
                    if type(subId) == "string" then
                        local num = subId:match("%d+")
                        if num then AnimationIdToName[num] = animName end
                    end
                end
            elseif type(animId) == "string" then
                local num = animId:match("%d+")
                if num then AnimationIdToName[num] = animName end
            end
        end
    end

    local count = 0
    for _ in pairs(AnimationIdToName) do count = count + 1 end
    if count == 0 and Library and Library.Notify then
        Library:Notify({
            Title = "Auto Block Disabled",
            Description = "Could not load killer animation configs. Auto Block will not fire.",
            Time = 10,
        })
    end
end

function GetAnimationType(ID)
