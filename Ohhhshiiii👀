function DefaultData(Path, Option)
    if isfile(DataFolder .. "/" .. Path) then return end
    writefile(DataFolder .. "/" .. Path, Option)
end
function ChangeData(Path, Option)
    if isfile(DataFolder .. "/" .. Path) then writefile(DataFolder .. "/" .. Path, Option) end
end
function ReturnData(Path)
    if isfile(DataFolder .. "/" .. Path) then return readfile(DataFolder .. "/" .. Path) end
    return nil
end

