function GetAnimationType(ID)
    for i, v in AllAnimations do
        for animtype, animId in v do
            if type(animId) == "table" then
                for _, v2 in animId do
                    if type(v2) == "string" and v2:find(tostring(ID)) then return animtype, i end
                end
            else
                if type(animId) == "string" and animId:find(tostring(ID)) then return animtype, i end
            end
        end
    end
end

function CanPlayOverrideAnim(Character)
    return Character and Character.Parent and GetValue("AnimationChanger") ~= "Original"
end

function UpdateAnim(Humanoid)
    local AnimSelected = GetValue("AnimationChanger")
    if not CanPlayOverrideAnim(LocalCharacter) or not LocalAnimator or not AllAnimations[AnimSelected] then return end
    local AnimString
    if Humanoid.MoveDirection ~= Vector3.zero then
        AnimString = AllAnimations[AnimSelected]["Walk"]
    else
        AnimString = AllAnimations[AnimSelected]["Idle"]
    end
    if AnimString then
        local animation = Instance.new("Animation")
        animation.AnimationId = AnimString
        local track = LocalAnimator:LoadAnimation(animation)
        track:Play(0.1)
    end
end

